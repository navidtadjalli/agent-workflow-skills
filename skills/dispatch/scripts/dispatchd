#!/usr/bin/env python3
"""Daemon entrypoint. Runs the tick loop in the foreground, under tmux."""
import os
import sys

# realpath, not abspath: these scripts get symlinked into place, and abspath
# would insert the symlink's own directory instead of the package's.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from dispatch.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(["run"] + sys.argv[1:]))
