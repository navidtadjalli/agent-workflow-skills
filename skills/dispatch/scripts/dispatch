#!/usr/bin/env python3
"""CLI entrypoint. Kept import-light so `dispatch status` is instant."""
import os
import sys

# realpath, not abspath: this lands on PATH as a symlink, and abspath would
# insert the symlink's own directory instead of the package's.
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from dispatch.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
